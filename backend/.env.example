# Copy to .env for local reference only - Spring Boot does NOT auto-load .env files.
# For local dev, either export these in your shell or rely on the defaults already
# baked into application.properties (localhost Postgres/Redis, dev JWT secret, etc).
# In production (Render), set these as real environment variables in the dashboard.

# --- Database ---
# Preferred: a single connection string from your hosting provider (Render, Neon, Railway...).
# Parsed automatically by DatabaseUrlEnvironmentPostProcessor into the JDBC url/user/password.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Alternative for local dev only (used if DATABASE_URL is not set):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_bank_manager
DB_USER=smart_bank_app
DB_PASSWORD=smart_bank_dev_pw

# --- Auth ---
# Generate a strong random value for production, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Business rules ---
LOAN_MANAGER_APPROVAL_THRESHOLD=500000

# --- Redis (used for ATM live-availability caching) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- File storage (KYC document uploads) ---
# NOTE: Render's filesystem is ephemeral - files here are lost on every redeploy/restart.
# Fine for a demo; for real use, swap this for S3/Cloudinary/etc.
KYC_STORAGE_DIR=./data/kyc-documents

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# --- Server ---
# Render sets this automatically - you normally don't need to set it yourself.
PORT=8080
